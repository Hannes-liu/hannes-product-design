      "id": "BASE-ANT",
      "category": "baseline",
      "name": "Ant Design 设计基线",
      "keywords": [
        "Ant Design",
        "antd",
        "数据管理",
        "表格",
        "表单",
        "桌面后台"
      ],
      "applies_to": {
