      "id": "PAT-DASHBOARD",
      "category": "pattern",
      "name": "分析看板与可执行下钻",
      "keywords": [
        "分析",
        "看板",
        "dashboard",
        "chart",
        "指标",
        "趋势",
        "下钻"
      ],
      "applies_to": {
        "tasks": [
          "观察指标",
          "比较与定位异常",
          "进入后续处理"
        ],
        "platforms": [
          "desktop-web",
          "mobile-web"
        ],
        "density": [
          "compact",
          "standard"
        ]
      },
      "recommendation": "先确定用户需要比较、观察趋势还是定位异常，再组织指标、图表和明细；可点击图表带筛选条件进入对应任务。",
      "rationale": "信息组织围绕判断与下一步行动，图表的统计范围和业务列表能核对。",
      "avoid": [
        "不堆叠无任务目的的指标或装饰图表。",
        "不写死互不对应的统计，不以颜色单独表达风险，不把不同职责的分析页复制为同一布局。"
      ],
      "requirements": [
        "标明单位、时间范围、分母及空数据口径。",
        "共享筛选和对象事实；下钻解释当前范围并提供明确返回。"
      ],
